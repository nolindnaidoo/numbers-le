[
	{
		"name": "a json document",
		"file": "numbers.json",
		"arguments": {
			"format": "json"
		},
		"expected": {
			"ok": true,
			"data": {
				"numbers": [
					8080,
					0.0825,
					-325,
					1,
					2.5,
					1000000,
					1e+21,
					1e-7
				],
				"fileType": "json"
			},
			"diagnostics": [],
			"meta": {
				"tool": "extract_numbers",
				"count": 8,
				"truncated": false
			}
		}
	},
	{
		"name": "format inferred from the filename",
		"file": "numbers.toml",
		"arguments": {
			"filename": "numbers.toml"
		},
		"expected": {
			"ok": true,
			"data": {
				"numbers": [
					8080,
					0.0825,
					26,
					1000,
					1,
					2,
					1.5,
					2.5
				],
				"fileType": "toml"
			},
			"diagnostics": [],
			"meta": {
				"tool": "extract_numbers",
				"count": 8,
				"truncated": false
			}
		}
	},
	{
		"name": "an alias resolves",
		"file": "numbers.yaml",
		"arguments": {
			"format": "yml"
		},
		"expected": {
			"ok": true,
			"data": {
				"numbers": [
					8080,
					0.0825,
					26,
					1,
					2.5
				],
				"fileType": "yaml"
			},
			"diagnostics": [],
			"meta": {
				"tool": "extract_numbers",
				"count": 5,
				"truncated": false
			}
		}
	},
	{
		"name": "coercion is on for dotenv",
		"file": "numbers.env",
		"arguments": {
			"format": "env"
		},
		"expected": {
			"ok": true,
			"data": {
				"numbers": [
					8080,
					0.0825,
					7,
					0.5
				],
				"fileType": "env"
			},
			"diagnostics": [],
			"meta": {
				"tool": "extract_numbers",
				"count": 4,
				"truncated": false
			}
		}
	},
	{
		"name": "an unknown format scans the text",
		"file": "numbers.txt",
		"arguments": {
			"format": "plaintext"
		},
		"expected": {
			"ok": true,
			"data": {
				"numbers": [
					1.2,
					0.3,
					0.0825,
					1000,
					-700
				],
				"fileType": "unknown"
			},
			"diagnostics": [],
			"meta": {
				"tool": "extract_numbers",
				"count": 5,
				"truncated": false
			}
		}
	},
	{
		"name": "no format at all scans the text",
		"file": "numbers.txt",
		"arguments": {},
		"expected": {
			"ok": true,
			"data": {
				"numbers": [
					1.2,
					0.3,
					0.0825,
					1000,
					-700
				],
				"fileType": "unknown"
			},
			"diagnostics": [],
			"meta": {
				"tool": "extract_numbers",
				"count": 5,
				"truncated": false
			}
		}
	},
	{
		"name": "deduped",
		"file": "numbers.csv",
		"arguments": {
			"format": "csv",
			"dedupe": true
		},
		"expected": {
			"ok": true,
			"data": {
				"numbers": [
					1,
					0.0825,
					2,
					3,
					-1500
				],
				"fileType": "csv"
			},
			"diagnostics": [],
			"meta": {
				"tool": "extract_numbers",
				"count": 5,
				"truncated": false
			}
		}
	},
	{
		"name": "capped and flagged",
		"file": "numbers.json",
		"arguments": {
			"format": "json",
			"maxResults": 3
		},
		"expected": {
			"ok": true,
			"data": {
				"numbers": [
					8080,
					0.0825,
					-325
				],
				"fileType": "json"
			},
			"diagnostics": [],
			"meta": {
				"tool": "extract_numbers",
				"count": 3,
				"truncated": true
			}
		}
	},
	{
		"name": "a document that will not parse",
		"file": "mixed-array.toml",
		"arguments": {
			"format": "toml"
		},
		"expected": {
			"ok": false,
			"data": {
				"numbers": [],
				"fileType": "toml"
			},
			"diagnostics": [
				{
					"severity": "error",
					"code": "parse-error",
					"message": "Failed to parse TOML: Inline lists must be a single type, not a mix of integer and float at row 1, col 18, pos 17:\n1> limits = [1, 2.5]\n                    ^\n2: \n\n"
				}
			],
			"meta": {
				"tool": "extract_numbers",
				"count": 0,
				"truncated": false
			}
		}
	},
	{
		"name": "nothing to find",
		"content": "",
		"arguments": {
			"format": "json"
		},
		"expected": {
			"ok": false,
			"data": {
				"numbers": [],
				"fileType": "json"
			},
			"diagnostics": [
				{
					"severity": "error",
					"code": "parse-error",
					"message": "Failed to parse JSON: JSON Parse error: Unexpected EOF"
				}
			],
			"meta": {
				"tool": "extract_numbers",
				"count": 0,
				"truncated": false
			}
		}
	},
	{
		"name": "content must be a string",
		"arguments": {
			"format": "json"
		},
		"expectedError": "content is required and must be a string"
	},
	{
		"name": "a nonsensical cap is rejected",
		"content": "1",
		"arguments": {
			"maxResults": 0
		},
		"expectedError": "maxResults must be a positive integer"
	}
]
